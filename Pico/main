import sys
import uselect
import ujson
import time
from machine import Pin, PWM

# Pin Assignments
RED_PIN = 2
GREEN_PIN = 3
BLUE_PIN = 4
BUZZER_PIN = 15

# Posture Warning Threshold (degrees of head tilt)
POSTURE_TILT_THRESHOLD = 25.0

# Initialize RGB LED Channels (Common Cathode: 1=ON, 0=OFF)
red_led = Pin(RED_PIN, Pin.OUT)
green_led = Pin(GREEN_PIN, Pin.OUT)
blue_led = Pin(BLUE_PIN, Pin.OUT)

# Initialize Buzzer with PWM for reliable tone generation
buzzer = PWM(Pin(BUZZER_PIN))
buzzer.duty_u16(0)  # Start muted


def set_rgb(r, g, b):
    """Sets RGB LED color (True = ON, False = OFF)."""
    red_led.value(1 if r else 0)
    green_led.value(1 if g else 0)
    blue_led.value(1 if b else 0)


def set_buzzer(enable, freq=1000):
    """Triggers PWM buzzer audio signal."""
    if enable:
        buzzer.freq(freq)
        buzzer.duty_u16(32768)  # 50% volume / duty cycle
    else:
        buzzer.duty_u16(0)      # Silence


# Non-blocking USB Serial Reader
spoll = uselect.poll()
spoll.register(sys.stdin, uselect.POLLIN)

# Set initial standby status (Blue LED)
set_rgb(r=False, g=False, b=True)
set_buzzer(False)

print("Pico Telemetry Receiver Started.")

while True:
    if spoll.poll(0):
        line = sys.stdin.readline().strip()
        if line:
            try:
                data = ujson.loads(line)
                status = str(data.get("status", "waiting"))
                pitch = abs(float(data.get("pitch", 0.0)))

                # 1. Update RGB LED state based on focus status
                if status == "focused":
                    set_rgb(r=False, g=True, b=False)   # Green
                elif status == "pending":
                    set_rgb(r=True, g=True, b=False)    # Amber / Yellow
                elif status == "unfocused":
                    set_rgb(r=True, g=False, b=False)   # Red
                else:
                    set_rgb(r=False, g=False, b=True)   # Blue (Standby / Offline)

                # 2. Check alert conditions (Bad Focus OR Bad Posture)
                is_bad_focus = (status == "unfocused")
                is_bad_posture = (pitch > POSTURE_TILT_THRESHOLD)

                # 3. Trigger Buzzer sound
                if is_bad_focus:
                    set_buzzer(True, freq=1800)  # High frequency alert for lost focus
                elif is_bad_posture:
                    set_buzzer(True, freq=900)   # Lower frequency alert for bad posture
                else:
                    set_buzzer(False)            # Mute when focus and posture are good

            except Exception:
                pass

    time.sleep(0.01)
